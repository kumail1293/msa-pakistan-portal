# Existing application settings
DATABASE_URL=
JWT_SECRET=

# MSAP Google Apps Script Web App URL (Deploy as Web app -> Execute as owner -> Anyone)
MSAP_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Phase 2 member accounts
# Public base URL used in password-setup emails (no trailing slash)
PORTAL_BASE_URL=
# Where issued membership cards + member accounts are snapshotted so they
# survive server restarts (default: .data/membership-store.json, gitignored).
# Set this to a stable absolute path in production, e.g. /var/lib/msap/store.json
MEMBER_STORE_FILE=
# Password setup token lifetime in milliseconds (default 24 hours)
PASSWORD_SETUP_TOKEN_EXPIRY_MS=86400000

# SMTP email delivery (any relay: Gmail app password, Zoho, Brevo, Mailgun,
# or Elastic Email's SMTP servers for a zero-budget option)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=MSA Pakistan
FROM_EMAIL=

# Phase 2 authentication (Supabase is recommended for the zero-budget member portal)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Official portal super admin bootstrap: when an existing portal account
# matches this email, it is promoted to super admin at boot. The super admin
# is the ONLY role that can provision officials and open modules for them.
SUPER_ADMIN_EMAIL=

# Official sign-in for MSAP officials ("Sign in with Google")
# Google-style OAuth provider base URL. Leave empty in development to use the
# bundled mock identity server - run `pnpm mock:oauth` (http://localhost:4100)
# in a second terminal. Point this at a real provider in production.
OAUTH_SERVER_URL=
# Optional OAuth client secret sent on the token exchange (unused by the mock)
OAUTH_CLIENT_SECRET=

# Development only - JSON list of accounts shown on the mock Google consent
# page, e.g. [{"email":"vpm@msapakistan.org","name":"M. Sarim Sheikh"}]
MOCK_GOOGLE_ACCOUNTS=
# Development only - port for `pnpm mock:oauth` (default 4100)
MOCK_OAUTH_PORT=4100

# Optional National President signature image (data URL or https URL). When
# set, every membership card renders this real signature instead of the
# cursive placeholder. Admins can also set it at runtime from the admin
# dashboard (Admin -> Card Issuance -> National President signature).
# NOTE: an https URL must be CORS-enabled so the browser PNG download
# (html2canvas) can read it; a data URL avoids CORS entirely.
PRESIDENT_SIGNATURE_URL=

# Optional Google Maps (client-side MapView component)
# SECURITY: this key ships in the browser bundle, so it must be a dedicated
# Google-Maps-only key restricted by HTTP referrer in Google Cloud Console.
# NEVER set it to the same value as BUILT_IN_FORGE_API_KEY (which can presign
# storage writes).
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional Analytics configuration
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

